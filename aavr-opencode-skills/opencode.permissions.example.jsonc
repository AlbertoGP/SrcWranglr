{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "ask",
      "aavr-*": "allow"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git rev-parse*": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "rm *": "deny",
      "sudo *": "deny",
      "git push*": "deny"
    },
    "edit": "ask",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
